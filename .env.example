# Neon pooled connection string (hostname normally contains -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB?sslmode=require"

# Neon direct connection string for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require"

# Generate a long random value before production deployment
AUTH_SECRET="replace-with-a-long-random-secret"
